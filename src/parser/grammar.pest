// Whitespace and comments are silently consumed; block comments do not nest.
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ "//" ~ (!"\n" ~ ANY)* ~ ("\n" | EOI) | "/*" ~ (!"*/" ~ ANY)* ~ "*/" }

// Import statement: import "path/to/contract.ark";
import_stmt = { "import" ~ string_literal ~ ";" }

// Version constraints are checked against the compiler version when a file is loaded.
pragma_keyword = @{ "pragma" ~ !(ASCII_ALPHANUMERIC | "_") }
pragma_language = @{ "arkade" ~ !(ASCII_ALPHANUMERIC | "_") }
pragma_version_part = _{ "0" | ASCII_NONZERO_DIGIT ~ ASCII_DIGIT* }
pragma_version = @{ pragma_version_part ~ "." ~ pragma_version_part ~ "." ~ pragma_version_part ~ !(ASCII_ALPHANUMERIC | "_" | ".") }
pragma_constraint = { (">=" | "<=" | ">" | "<" | "=" | "^" | "~")? ~ pragma_version }
pragma_range = { pragma_constraint+ }
pragma_stmt = { pragma_keyword ~ pragma_language ~ pragma_range ~ ("||" ~ pragma_range)* ~ ";" }
// A file's leading pragma alone, so it is checked even when the rest of the file does not parse.
pragma_head = { SOI ~ pragma_stmt }

// Main entry point - must consume the entire input
main = { SOI ~ pragma_stmt? ~ import_stmt* ~ struct_definition* ~ (attribute* ~ (contract | library))? ~ EOI }

// Outer attribute of the contract, function or statement after it: @name(arg, ...)
attribute = { "@" ~ identifier ~ "(" ~ attribute_arg ~ ("," ~ attribute_arg)* ~ ","? ~ ")" }
attribute_arg = _{ string_literal | attribute_name }
attribute_name = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "-" | "_")* }

struct_definition = {
    "struct" ~ identifier ~ "{" ~ struct_field+ ~ "}"
}

struct_field = { data_type ~ identifier ~ ";" }

// Contract definition
contract = {
    "contract" ~ identifier ~
    "(" ~ param_list ~ ")" ~
    "{" ~ (const_decl | attribute* ~ function)* ~ "}"
}

library = {
    "library" ~ identifier ~ "{" ~ (const_decl | attribute* ~ function)* ~ "}"
}

// Compile-time constant: const int NAME = 144;
const_keyword = @{ "const" ~ !(ASCII_ALPHANUMERIC | "_") }
const_decl = { const_keyword ~ data_type ~ identifier ~ "=" ~ general_expression ~ ";" }

// Parameter list; every comma-separated list accepts a trailing comma after its last element.
param_list = {
    (parameter ~ ("," ~ parameter)* ~ ","?)?
}

// Parameter definition
parameter = { data_type ~ identifier }

// Supported data types - atomic rule to prevent partial matches
// Note: longer types must come before shorter prefixes (bytes32/bytes20 before bytes)
// Array types carry a positive literal or constant size (e.g., pubkey[3], int[Config.SIZE])
array_size = @{ !"0" ~ number_literal | qualified_name }
data_type = { identifier ~ ("[" ~ array_size ~ "]")? }

// A function without a modifier is public. Tapscript declarations have no return type.
function = {
    function_visibility? ~ "function" ~ identifier ~
    "(" ~ param_list ~ ")" ~
    ( "tapscript" ~ tapscript_block
    | data_type? ~ "{" ~ statement* ~ "}" )
}
function_visibility = @{ ("private" | "static") ~ !(ASCII_ALPHANUMERIC | "_") }
tapscript_block = { "{" ~ tap_require_stmt* ~ "}" }
tap_require_stmt = { "require" ~ "(" ~ tap_require_expression ~ ("," ~ string_literal)? ~ ","? ~ ")" ~ ";" }
tap_require_expression = _{
    ((check_sig | check_multisig | time_comparison | hash_comparison) ~ &("," | ")")) |
    general_expression
}
return_keyword = @{ "return" ~ !(ASCII_ALPHANUMERIC | "_") }
return_stmt = { return_keyword ~ general_expression? ~ ";" }

// Statement types - order matters, more specific first
statement = _{ attribute* ~ statement_kind }
statement_kind = _{
    return_stmt |
    if_stmt |
    for_stmt |
    let_binding |
    var_assign |
    require_stmt |
    function_call_stmt |
    variable_declaration
}

// If statement with optional else; `else if` is an else block holding one `if`.
if_stmt = {
    "if" ~ "(" ~ general_expression ~ ")" ~ block ~ (else_keyword ~ (if_stmt | block))?
}
else_keyword = @{ "else" ~ !(ASCII_ALPHANUMERIC | "_") }

// For loop statement (compile-time unrolled)
for_stmt = { for_in_stmt | for_count_stmt }
for_in_stmt = {
    "for" ~ "(" ~ identifier ~ "," ~ identifier ~ ")" ~ "in" ~ general_expression ~ block
}
for_count_stmt = {
    "for" ~ "(" ~ general_expression ~ ")" ~ block
}

// Block of statements
block = { "{" ~ statement* ~ "}" }

// Let binding (new variable with let keyword)
let_keyword = @{ "let" ~ !(ASCII_ALPHANUMERIC | "_") }
let_binding = {
    &let_keyword ~ "let" ~ identifier ~ "=" ~ general_expression ~ ";"
}

// Variable assignment (reassignment without let keyword)
// Must check for = but not == or >= or <=
var_assign = {
    assignment_target ~ "=" ~ !("=") ~ general_expression ~ ";"
}

assignment_target = {
    identifier ~ binding_suffix*
}

// Require statement
require_stmt = {
    "require" ~ "(" ~ require_expression ~ ("," ~ string_literal)? ~ ","? ~ ")" ~ ";"
}

require_expression = _{
    general_expression
}

// Function call statement: `f(args);` or `Lib.f(args);`
function_call_stmt = {
    identifier ~ ("." ~ identifier)? ~ call_args ~ ";"
}

// Variable declaration (typed)
variable_declaration = {
    !let_keyword ~ data_type ~ identifier ~ ("=" ~ general_expression)? ~ ";"
}

// General expression with operator precedence
// Used in conditions, let bindings, and assignments
general_expression = { logical_or_expr }
logical_or_expr = { logical_and_expr ~ (or_op ~ logical_and_expr)* }
logical_and_expr = { comparison_expr ~ (and_op ~ comparison_expr)* }

// Comparisons bind tighter than logical operators.
comparison_expr = {
    bit_or_expr ~ (comparison_operator ~ bit_or_expr)?
}

// Bytewise operators bind tighter than comparisons, so `a & mask == b` is
// `(a & mask) == b`; shifts bind looser than `+` and `-`.
bit_or_expr = { bit_xor_expr ~ (bit_or_op ~ bit_xor_expr)* }
bit_xor_expr = { bit_and_expr ~ (bit_xor_op ~ bit_and_expr)* }
bit_and_expr = { shift_expr ~ (bit_and_op ~ shift_expr)* }
shift_expr = { additive_expr ~ (shift_op ~ additive_expr)* }

// Additive expressions (+ and -)
additive_expr = {
    multiplicative_expr ~ ((add_op | sub_op) ~ multiplicative_expr)*
}

// Multiplicative expressions (* / %)
multiplicative_expr = {
    unary_expr ~ ((mul_op | div_op | rem_op) ~ unary_expr)*
}

// Prefix operators bind tighter than multiplication and apply right to left.
unary_expr = { (sub_op | not_op | invert_op)* ~ primary_expr }

parenthesized_expr = { "(" ~ general_expression ~ ")" }

// An operand and its suffixes, applied left to right. The parser resolves casts and builtins by
// name, and the members of `tx` and `this` (such as `tx.inputs[i].assets.lookup(id)` and
// `this.tunnel(...)`), library calls and `group.controlIs(id)` from the chain.
primary_expr = {
    (parenthesized_expr |
    function_call |
    constructor |
    typed_struct_literal |
    struct_literal |
    array_literal |
    byte_literal |
    bool_literal |
    number_literal |
    identifier) ~ postfix*
}

// A field, a member call or an index: `.name`, `.name(args)`, `[index]`.
postfix = { "." ~ identifier ~ call_args? | "[" ~ general_expression ~ "]" }
// `[]` is an empty list, which only `this.tunnel` takes, for its exceptions.
call_args = { "(" ~ (call_arg ~ ("," ~ call_arg)* ~ ","?)? ~ ")" }
call_arg = _{ general_expression | empty_list }
empty_list = { "[" ~ "]" }

// Field and index suffixes may alternate for arrays of structs.
binding_suffix = { ("." ~ identifier) | ("[" ~ general_expression ~ "]") }

// Operators
comparison_operator = { ">=" | "<=" | "==" | "!=" | ">" | "<" }
bool_literal = @{ ("true" | "false") ~ !(ASCII_ALPHANUMERIC | "_") }
add_op = { "+" }
sub_op = { "-" }
not_op = { "!" ~ !"=" }
and_op = { "&&" }
or_op = { "||" }
bit_and_op = @{ "&" ~ !"&" }
bit_or_op = @{ "|" ~ !"|" }
bit_xor_op = { "^" }
shift_op = { "<<" | ">>" }
invert_op = { "~" }
mul_op = { "*" }
div_op = { "/" }
rem_op = { "%" }

// ─── Standard Comparisons ──────────────────────────────────────────────────────

// Locktime comparison (tx.locktime >= timelock), rejected in tapscript
time_comparison = {
    "tx.locktime" ~ ">=" ~ additive_expr
}

// Generalized hash condition function name.
hash_fn_name = { "sha256" | "hash256" | "hash160" | "ripemd160" }

// Generalized hash function: hashFn(expr)
hash_func = { hash_fn_name ~ "(" ~ additive_expr ~ ","? ~ ")" }

// Hash comparison fast path: hashFn(preimage) == hash with a simple RHS.
// Other RHS forms parse as a general comparison.
// The fast path must consume the whole require/constructor argument.
hash_comparison = {
    hash_func ~ "==" ~ (byte_literal | named_binding) ~ &("," | ")")
}

// Constructor expression: new ContractName(args)
constructor = {
    "new" ~ identifier ~ "(" ~ constructor_args ~ ")"
}

// Arguments for constructor (optional - allows zero-arg constructors)
constructor_args = {
    (general_expression ~ ("," ~ general_expression)* ~ ","?)?
}

// Array literal — initializes a local array declaration
array_literal = {
    "[" ~ general_expression ~ ("," ~ general_expression)* ~ ","? ~ "]"
}

struct_literal = {
    "{" ~ struct_literal_field ~ ("," ~ struct_literal_field)* ~ ","? ~ "}"
}

struct_literal_field = { identifier ~ ":" ~ general_expression }

// `Point { x: 1, y: 2 }`. A block after an expression, as in `for (i, x) in items { ... }`,
// is no literal: a statement never starts with `name:`. The lookahead keeps a name followed by
// anything else, such as a missing `;`, from reporting an expected literal.
typed_struct_literal = { identifier ~ &"{" ~ struct_literal }

// A constant's name: `NAME` or `Lib.NAME`
qualified_name = @{ identifier ~ ("." ~ identifier)? }

// A call by name: a function, a builtin or a cast such as `bytes32(x)`.
function_call = {
    identifier ~ "(" ~ (general_expression ~ ("," ~ general_expression)* ~ ","?)? ~ ")"
}

// ─── Cryptographic Primitives ──────────────────────────────────────────────────

// Key expression: a bare pubkey identifier (operator, owner, …) or a tweak.
// Used only inside checkSig/checkMultisig.
key_expr = { tweak_key | named_binding }

// tweak(base, funcName): base is `operator` or a constructor pubkey.
tweak_key = { "tweak" ~ "(" ~ identifier ~ "," ~ identifier ~ ","? ~ ")" }

// Array of key expressions (widens `array`, which is identifier-only).
key_array = { "[" ~ key_expr ~ ("," ~ key_expr)* ~ ","? ~ "]" }

// CheckSig expression — key position accepts a key expression (incl. tweak()).
check_sig = {
    "checkSig" ~ "(" ~ named_binding ~ "," ~ key_expr ~ ","? ~ ")"
}

// checkMultisig([keys], [sigs]) — keys may be tweak()s; the second array carries the
// aligned signature inputs. arkd recognizes only N-of-N closures, so it takes no threshold.
check_multisig = {
    "checkMultisig" ~ "(" ~ key_array ~ "," ~ array ~ ","? ~ ")"
}

// Array of identifiers
array = {
    "[" ~ named_binding ~ ("," ~ named_binding)* ~ ","? ~ "]"
}

// Named operands used by crypto checks: a binding with field and index suffixes.
named_binding = { identifier ~ binding_suffix* }

// ─── Terminals ─────────────────────────────────────────────────────────────────

// Identifiers must start with a letter and can contain letters, numbers, and underscores
identifier = @{
    ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")*
}

// Number literals use canonical decimal notation; a `_` may separate two digits.
number_literal = @{
    "0" | ASCII_NONZERO_DIGIT ~ ("_"? ~ ASCII_DIGIT)*
}

// Byte literals contain whole byte pairs; both hex digit cases are accepted.
byte_literal = _{ hex_literal | string_literal }
hex_literal = @{ "0x" ~ (ASCII_HEX_DIGIT ~ ASCII_HEX_DIGIT)+ ~ !(ASCII_ALPHANUMERIC | "_") }

// Strings use JSON escapes and UTF-8 encoding.
string_literal = @{
    "\"" ~ ("\\" ~ ("\"" | "\\" | "/" | "b" | "f" | "n" | "r" | "t" | "u" ~ ASCII_HEX_DIGIT{4}) | !("\"" | "\\" | '\u{0000}'..'\u{001f}') ~ ANY)* ~ "\""
}
