struct Inner {
  int b;
}

struct Rules {
  int a_b;
  Inner a;
  int[3] weights;
}

struct Account {
  pubkey owner;
  Rules rules;
}

contract Structs(Account account) {
  function spend(
    Rules supplied,
    ECPoint generator,
    int index,
    int expected,
    signature ownerSig
  ) {
    require(account.rules.a_b == 11, "constructor field");
    require(account.rules.a.b == 17, "nested constructor field");
    require(account.rules.weights[2] == 23, "constructor array field");
    require(supplied.a_b == 29, "function field");
    require(supplied.a.b == 37, "nested function field");
    require(supplied.weights[index] == 43, "indexed struct array");

    Rules local = {
      weights: [supplied.weights[0], supplied.weights[1], supplied.weights[2]],
      a: { b: supplied.a.b },
      a_b: supplied.a_b
    };
    local.a.b = local.a.b + account.rules.a.b;
    local.weights[1] = local.weights[1] + account.rules.weights[1];

    int total = local.a_b + local.a.b;
    for (i, weight) in local.weights {
      total = total + (weight * (i + 1));
    }
    require(local.weights.length == 3, "array field length");
    require(total == expected, "local struct result");
    require(local != supplied, "mutated struct differs");
    require(supplied.weights == [41, 43, 47], "whole array equality");

    let indexedOutpoint = tx.inputs[0].outpoint;
    Outpoint currentOutpoint = tx.input.current.outpoint;
    require(indexedOutpoint.txid == currentOutpoint.txid, "outpoint txid");
    require(indexedOutpoint.vout == currentOutpoint.vout, "outpoint vout");
    require(currentOutpoint.vout == 0, "funding vout");
    require(indexedOutpoint == currentOutpoint, "whole outpoint equality");

    let outputAssetId = tx.outputs[0].assets[0].assetId;
    require(outputAssetId.gidx == 0, "asset group index");
    require(tx.outputs[0].assets.lookup(outputAssetId.txid, outputAssetId.gidx) == 7, "asset lookup");
    let assetGroup = tx.assetGroups.find(outputAssetId.txid, outputAssetId.gidx);
    AssetId groupAssetId = assetGroup.assetId;
    require(groupAssetId.txid == outputAssetId.txid, "group asset txid");
    require(groupAssetId.gidx == outputAssetId.gidx, "group asset index");
    require(groupAssetId == outputAssetId, "whole asset id equality");

    ECPoint added = ecAdd(generator, generator, 0);
    let multiplied = ecMul(generator, 2, 0);
    require(added.x == multiplied.x, "ecAdd x");
    require(added.y == multiplied.y, "ecAdd y");
    require(added == multiplied, "whole ec point equality");
    require(ecMul(generator, 1, 0) == generator, "ecMul identity");
    ECPoint identity = { x: 0, y: 0 };
    require(ecAdd(identity, generator, 0) == generator, "ecAdd identity point");
    require(ecAdd((ecAdd(generator, generator, 0)), generator, 0) == ecMul(generator, 3, 0), "nested ecAdd");

    require(checkSig(ownerSig, account.owner));
  }

  private function copyRules(Rules[2] items) Rules[2] {
    return items;
  }

  private function sumFields(Rules item) int {
    return item.a_b + item.a.b;
  }

  function arraySpend(Rules[2] provided, int row, int column, int next, int expected) {
    Rules[2] local = copyRules(provided);
    local[row].weights[column] = next;
    require(local[row].weights[column] == next);
    let selected = provided[row];
    require(selected.a.b == expected);
    require(sumFields(local[row]) == local[row].a_b + local[row].a.b);
    for (i, item) in local {
      require(item.a_b == provided[i].a_b);
      require(item.a.b == provided[i].a.b);
      for (j, weight) in item.weights {
        if (i == row && j == column) {
          require(weight == next);
        } else {
          require(weight == provided[i].weights[j]);
        }
      }
    }
  }
}
