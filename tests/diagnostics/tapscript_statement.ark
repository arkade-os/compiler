contract Vault(pubkey owner, bool early) {
  function spend(signature sig) {
    require(checkSig(sig, owner));
    require(tx.outputs[0].value >= 1000);
  }

  function unilateral(signature sig) tapscript {
    if (early) { require(older(operatorExitDelay)); }
    require(checkSig(sig, owner));
  }
}
