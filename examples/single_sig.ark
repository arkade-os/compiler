contract SingleSig(
  pubkey user,
  int exit
) {
  // Single signature spend path
  function spend(signature userSig) {
    require(checkSig(userSig, user));
  }

  // Unilateral exit (CSV).
  function unilateral(signature userSig) tapscript {
    require(older(exit));
    require(checkSig(userSig, user));
  }
}
