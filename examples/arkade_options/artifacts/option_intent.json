  "source": {
    "entry": "option_intent.ark",
    "files": {
      "option_intent.ark": "pragma arkade ^0.1.0;\n\n// 30-second RFQ lock. Same shape as NonInteractiveSwap: the maker locks coins,\n// a taker finalizes by funding the named outputs, and the maker cancels once\n// the emulator clock passes `deadline`. `older(exit)` is the operator-down path.\n//\n// side 0, user is the writer: the coin is the notional Q. Finalize pays the\n// premium plus any sats above Q back to `userScript`, and at least Q to the\n// committed option script.\n// side 1, user is the holder: the coin is the premium. Finalize pays that\n// premium to `solverScript`, at least Q to the option script, and any change\n// above dust back to `userScript`.\n//\n// Finalize and cancel are mutually exclusive: finalize requires the deadline\n// has not been reached, cancel requires `checkTime(deadline)`.\n\ncontract OptionIntent(\n  pubkey userPk,\n  bytes32 userScript,\n  bytes32 solverScript,\n  bytes32 optionScript,\n  int side,\n  int collateral,\n  int premium,\n  int deadline,\n  int exit\n) {\n  const int DUST = 330;\n\n  function finalize() {\n    require(side == 0 || side == 1, \"side\");\n    require(collateral > DUST, \"collateral\");\n    require(premium > DUST, \"premium\");\n    require(!checkTime(deadline), \"expired\");\n    int locked = tx.input.current.value;\n    if (side == 0) {\n      require(locked >= collateral, \"short collateral\");\n      int change = locked - collateral;\n      require(tx.outputs[0].value >= premium + change, \"premium\");\n      require(tx.outputs[0].scriptPubKey == userScript, \"user\");\n      require(tx.outputs[1].value >= collateral, \"option size\");\n      require(tx.outputs[1].scriptPubKey == optionScript, \"option\");\n    }\n    if (side == 1) {\n      require(locked >= premium, \"short premium\");\n      require(tx.outputs[0].value >= premium, \"premium\");\n      require(tx.outputs[0].scriptPubKey == solverScript, \"solver\");\n      require(tx.outputs[1].value >= collateral, \"option size\");\n      require(tx.outputs[1].scriptPubKey == optionScript, \"option\");\n      int change = locked - premium;\n      if (change > DUST) {\n        require(tx.outputs[2].value >= change, \"change\");\n        require(tx.outputs[2].scriptPubKey == userScript, \"change\");\n      }\n    }\n  }\n\n  function cancel() {\n    require(tx.numInputs == 1, \"one input\");\n    require(checkTime(deadline), \"open\");\n    require(tx.outputs[0].value >= tx.input.current.value, \"refund\");\n    require(tx.outputs[0].scriptPubKey == userScript, \"user\");\n  }\n\n  function unilateral(signature userSig) tapscript {\n    require(older(exit));\n    require(checkSig(userSig, userPk));\n  }\n}\n"
    }
  },
