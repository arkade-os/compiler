      "option_vault.ark": "pragma arkade ^0.1.0;\n\n// Cash-settled covered call (kind 0) and limited put (kind 1).\n//\n// Collateral is the BTC notional Q. Settlement price ST is a step-function\n// TWAP of three median prints. Each print is the median of three prices from\n// distinct oracles, and each oracle signs sha256(\"BTCUSD\" || price_le64 || time_le64).\n// The bucket timestamp is the max observation time (oracle doc §4).\n//\n// Slices, relative to expiry (unix seconds):\n//   open   [expiry-1800, expiry-1740]\n//   mid    [expiry-960,  expiry-900]\n//   close  [expiry,      expiry+60]\n// Observations in a slice sit within 60 seconds of that slice's max.\n//\n//   ST = (mOpen*900 + mMid*900 + mClose*60) / 1860\n// The 900/900/60 weights are the bucket durations (15 min, 15 min, the\n// settlement minute). They are not the picked timestamps, so a print on\n// either edge of a slice cannot change its weight.\n//\n// Prices are USD cents. Q and payoffs are sats. Division truncates.\n//   covered call: ST <= K → holder 0, else Q*(ST-K)/ST\n//   limited put:  ST >= K → holder 0, else min(Q, Q*(K-ST)/ST)\n// A sub-330-sat leg is folded into the other output.\n//\n// Spend paths: settle (anyone, after the oracle window), close (writer and\n// holder together), unilateral (writer, after CSV). Follows the vault note\n// in the options spec. Output scripts are 32-byte witness programs.\n\ncontract OptionVault(\n  int kind,\n  pubkey writerPk,\n  pubkey holderPk,\n  bytes32 writerScript,\n  bytes32 holderScript,\n  int strike,\n  int collateral,\n  int expiry,\n  pubkey[5] oracles,\n  int exit\n) {\n  const int DUST = 330;\n  const int PRICE_MAX = 1000000000;\n  const int Q_MAX = 1000000000;\n\n  private function median3(int a, int b, int c) int {\n    if (a <= b && b <= c) { return b; }\n    if (a <= c && c <= b) { return c; }\n    if (b <= a && a <= c) { return a; }\n    if (b <= c && c <= a) { return c; }\n    if (c <= a && a <= b) { return a; }\n    return b;\n  }\n\n  private function max3(int a, int b, int c) int {\n    if (a >= b && a >= c) { return a; }\n    if (b >= a && b >= c) { return b; }\n    return c;\n  }\n\n  private function min3(int a, int b, int c) int {\n    if (a <= b && a <= c) { return a; }\n    if (b <= a && b <= c) { return b; }\n    return c;\n  }\n\n  private function attest(int price, int time, int index, signature sig) {\n    require(price > 0, \"nonpositive price\");\n    require(price <= PRICE_MAX, \"price cap\");\n    require(time > 0, \"nonpositive time\");\n    let ticker = 0x425443555344;\n    let msg = sha256(ticker + num2bin(price, 8) + num2bin(time, 8));\n    require(checkSigFromStack(sig, oracles[index], msg), \"bad oracle sig\");\n  }\n\n  private function slice(int a, int b, int c, int lo, int hi) {\n    int top = max3(a, b, c);\n    int bot = min3(a, b, c);\n    require(top - bot <= 60, \"oracle spread\");\n    require(top >= lo, \"slice early\");\n    require(top <= hi, \"slice late\");\n  }\n\n  function settle(\n    int[3] price0,\n    int[3] time0,\n    int[3] who0,\n    signature[3] sig0,\n    int[3] price1,\n    int[3] time1,\n    int[3] who1,\n    signature[3] sig1,\n    int[3] price2,\n    int[3] time2,\n    int[3] who2,\n    signature[3] sig2\n  ) {\n    require(kind == 0 || kind == 1, \"kind\");\n    require(strike > 0, \"strike\");\n    require(strike <= PRICE_MAX, \"strike cap\");\n    require(collateral > DUST, \"collateral\");\n    require(collateral <= Q_MAX, \"collateral cap\");\n    require(expiry > 1800, \"expiry\");\n    require(tx.numInputs == 1, \"one input\");\n\n    require(who0[0] != who0[1], \"same oracle\");\n    require(who0[0] != who0[2], \"same oracle\");\n    require(who0[1] != who0[2], \"same oracle\");\n    require(who1[0] != who1[1], \"same oracle\");\n    require(who1[0] != who1[2], \"same oracle\");\n    require(who1[1] != who1[2], \"same oracle\");\n    require(who2[0] != who2[1], \"same oracle\");\n    require(who2[0] != who2[2], \"same oracle\");\n    require(who2[1] != who2[2], \"same oracle\");\n\n    for (i, px) in price0 {\n      attest(px, time0[i], who0[i], sig0[i]);\n    }\n    for (i, px) in price1 {\n      attest(px, time1[i], who1[i], sig1[i]);\n    }\n    for (i, px) in price2 {\n      attest(px, time2[i], who2[i], sig2[i]);\n    }\n\n    int m0 = median3(price0[0], price0[1], price0[2]);\n    int m1 = median3(price1[0], price1[1], price1[2]);\n    int m2 = median3(price2[0], price2[1], price2[2]);\n    slice(time0[0], time0[1], time0[2], expiry - 1800, expiry - 1740);\n    slice(time1[0], time1[1], time1[2], expiry - 960, expiry - 900);\n    slice(time2[0], time2[1], time2[2], expiry, expiry + 60);\n\n    int twap = (m0 * 900 + m1 * 900 + m2 * 60) / 1860;\n    require(twap > 0, \"zero twap\");\n\n    int ph = 0;\n    if (kind == 0) {\n      if (twap > strike) {\n        ph = collateral * (twap - strike) / twap;\n      }\n    }\n    if (kind == 1) {\n      if (twap < strike) {\n        ph = collateral * (strike - twap) / twap;\n        if (ph > collateral) {\n          ph = collateral;\n        }\n      }\n    }\n    require(ph <= collateral, \"holder overpaid\");\n\n    int locked = tx.input.current.value;\n    require(locked >= collateral, \"underfunded\");\n    int writerAmt = locked - ph;\n\n    if (ph > DUST && writerAmt > DUST) {\n      require(tx.outputs[0].value >= ph, \"holder short\");\n      require(tx.outputs[0].scriptPubKey == holderScript, \"holder script\");\n      require(tx.outputs[1].value >= writerAmt, \"writer short\");\n      require(tx.outputs[1].scriptPubKey == writerScript, \"writer script\");\n    }\n    if (ph <= DUST) {\n      require(tx.outputs[0].value >= locked, \"writer short\");\n      require(tx.outputs[0].scriptPubKey == writerScript, \"writer script\");\n    }\n    if (writerAmt <= DUST && ph > DUST) {\n      require(tx.outputs[0].value >= locked, \"holder short\");\n      require(tx.outputs[0].scriptPubKey == holderScript, \"holder script\");\n    }\n  }\n\n  function close(signature writerSig, signature holderSig) {\n    require(checkSig(writerSig, writerPk), \"writer\");\n    require(checkSig(holderSig, holderPk), \"holder\");\n  }\n\n  function unilateral(signature writerSig) tapscript {\n    require(older(exit));\n    require(checkSig(writerSig, writerPk));\n  }\n}\n"
    }
  },
