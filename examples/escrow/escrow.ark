pragma arkade ^0.1.0;

// Escrow Contract
//
// Marketplace escrow with three spending paths. The classic construction is a
// 2-of-3 multisig: buyer+seller release, buyer+timeout refund, mediator+party
// dispute. Every path there needs a counterparty to be online and to sign the
// settlement transaction. This contract keeps the same three paths and removes
// that requirement by pinning each payout with introspection and by letting the
// mediator speak through a signed attestation instead of a transaction
// signature.
//
//   Path      Authorization                 Payout enforced by
//   release   buyer signature               covenant → seller
//   refund    absolute locktime, no key     covenant → buyer
//   resolve   oracle attestation            covenant → verdict split
//
// What each upgrade buys:
//
//   Release no longer collects the seller's signature. The buyer alone
//   authorizes, and the covenant pins output 0 to `new SingleSig(sellerPk,
//   exit)`, so the only transaction the buyer can get signed is the one that
//   pays the seller. An absent seller can no longer stall their own payment.
//
//   Refund collects no signature at all. Past `refundLocktime` the covenant
//   pins output 0 to the buyer, so any party — the operator, a watchtower, the
//   seller — can push the refund and it can only land on the buyer.
//
//   Resolve replaces the mediator's transaction signature with a signed
//   verdict over `sha256(dealId || sellerShareBps || attestedAt)`. The mediator
//   never sees the transaction, the parties, or the amounts: `dealId` is an
//   opaque handle, so one blinded key can arbitrate many deals without learning
//   any of them. The verdict is a share, not a destination, and the covenant
//   turns it into outputs.
//
// Attestation message, as the mediator's signer must build it:
//
//   msg = sha256(dealId || num2bin(sellerShareBps, 8) || num2bin(attestedAt, 8))
//   sig = schnorr_sign(oracleKey, msg)
//
// `dealId` binds the verdict to this escrow instance — it is constructor state,
// so it is committed in the scriptPubKey and a verdict issued for one deal is
// worthless against another.
//
// Resolve output layout, selected by the attested share so a client can build
// the transaction from the verdict alone:
//
//   sellerShareBps == 0       output[0] buyer  (net)   output[1] mediator (fee)
//   sellerShareBps == 10000   output[0] seller (net)   output[1] mediator (fee)
//   otherwise                 output[0] seller         output[1] buyer
//                             output[2] mediator (fee)
//
// Known ceiling: release and refund race after `refundLocktime`, exactly as an
// HTLC's claim and refund do. A verdict stays spendable past the deadline, so
// set `refundLocktime` beyond the mediation SLA and have the winning party
// broadcast on receipt. Removing the race needs contract state that records an
// open dispute, which costs a state-transition spend and a second VTXO round
// trip; add it when mediation routinely outruns the refund window.

import "../single_sig/single_sig.ark";

contract Escrow(
  // Funds the escrow. Signs to release, is refunded on timeout.
  pubkey  buyerPk,
  // Paid on release, and on a verdict that awards them a share.
  pubkey  sellerPk,
  // The mediator's attestation key. Verified with checkSigFromStack over the
  // verdict message; never signs a transaction. May be blinded per deal.
  pubkey  oraclePk,
  // Where the mediation fee is paid. Separate from oraclePk on purpose: a
  // blinded attestation key is not a key anyone can spend from.
  pubkey  mediatorPk,
  // Opaque deal handle the mediator signs over. Committed here, so a verdict
  // is bound to this escrow and to nothing else.
  bytes32 dealId,
  // Flat mediation fee in sats, charged only when a verdict settles the deal.
  int     mediationFee,
  // Absolute locktime after which the buyer is refunded.
  int     refundLocktime,
  // Unilateral exit delay in blocks.
  int     exit
) {
  // Smallest viable Taproot output.
  const int DUST = 330;
  const int BPS = 10000;

  // -------------------------------------------------------------------------
  // RELEASE — buyer confirms delivery; the covenant pays the seller.
  //
  //   input[0]:  this Escrow VTXO
  //   output[0]: seller receives the full escrow
  // -------------------------------------------------------------------------
  function release(signature buyerSig) {
    require(checkSig(buyerSig, buyerPk), "invalid buyer signature");

    int settled = tx.input.current.value;
    require(tx.outputs[0].value >= settled, "seller underpaid");
    require(
      tx.outputs[0].scriptPubKey == new SingleSig(sellerPk, exit),
      "output 0 not seller"
    );
  }

  // -------------------------------------------------------------------------
  // REFUND — past the deadline the escrow unwinds to the buyer. No signature:
  // the destination is fixed, so anyone may push it.
  //
  //   input[0]:  this Escrow VTXO
  //   output[0]: buyer receives the full escrow
  // -------------------------------------------------------------------------
  function refund() {
    require(tx.time >= refundLocktime, "refund locktime not reached");

    int settled = tx.input.current.value;
    require(tx.outputs[0].value >= settled, "buyer underpaid");
    require(
      tx.outputs[0].scriptPubKey == new SingleSig(buyerPk, exit),
      "output 0 not buyer"
    );
  }

  // -------------------------------------------------------------------------
  // RESOLVE — the mediator's signed verdict splits the escrow. No party
  // signature and no mediator transaction signature: the attestation fixes the
  // split and the covenant fixes the destinations.
  // -------------------------------------------------------------------------
  function resolve(int sellerShareBps, int attestedAt, signature oracleSig) {
    require(sellerShareBps >= 0, "negative seller share");
    require(sellerShareBps <= BPS, "seller share above 100%");

    // A mediator cannot be paid a sub-dust output, so a deal that wants
    // mediation has to commit a fee that can be paid.
    require(mediationFee >= DUST, "mediation fee below dust");

    let verdict = sha256(dealId + num2bin(sellerShareBps, 8) + num2bin(attestedAt, 8));
    require(checkSigFromStack(oracleSig, oraclePk, verdict), "invalid oracle attestation");
    // The emulator's clock must have reached the stamp the mediator signed;
    // a post-dated verdict is not yet a verdict.
    require(checkTime(attestedAt), "attestation post-dated");

    int settled = tx.input.current.value;
    require(settled > mediationFee, "escrow below mediation fee");
    int net = settled - mediationFee;

    // Truncating division: the buyer takes the remainder, so the two shares
    // always re-add to `net` and nothing is stranded.
    int sellerAmount = net * sellerShareBps / BPS;
    int buyerAmount = net - sellerAmount;

    if (sellerShareBps == 0) {
      require(tx.outputs[0].value >= net, "buyer underpaid");
      require(
        tx.outputs[0].scriptPubKey == new SingleSig(buyerPk, exit),
        "output 0 not buyer"
      );
      require(tx.outputs[1].value >= mediationFee, "mediator underpaid");
      require(
        tx.outputs[1].scriptPubKey == new SingleSig(mediatorPk, exit),
        "output 1 not mediator"
      );
    } else {
      if (sellerShareBps == BPS) {
        require(tx.outputs[0].value >= net, "seller underpaid");
        require(
          tx.outputs[0].scriptPubKey == new SingleSig(sellerPk, exit),
          "output 0 not seller"
        );
        require(tx.outputs[1].value >= mediationFee, "mediator underpaid");
        require(
          tx.outputs[1].scriptPubKey == new SingleSig(mediatorPk, exit),
          "output 1 not mediator"
        );
      } else {
        // A split verdict must be payable on both sides. The mediator rounds
        // to 0 or 10000 rather than stranding a party below dust.
        require(sellerAmount > DUST, "seller share below dust");
        require(buyerAmount > DUST, "buyer share below dust");

        require(tx.outputs[0].value >= sellerAmount, "seller underpaid");
        require(
          tx.outputs[0].scriptPubKey == new SingleSig(sellerPk, exit),
          "output 0 not seller"
        );
        require(tx.outputs[1].value >= buyerAmount, "buyer underpaid");
        require(
          tx.outputs[1].scriptPubKey == new SingleSig(buyerPk, exit),
          "output 1 not buyer"
        );
        require(tx.outputs[2].value >= mediationFee, "mediator underpaid");
        require(
          tx.outputs[2].scriptPubKey == new SingleSig(mediatorPk, exit),
          "output 2 not mediator"
        );
      }
    }
  }

  // -------------------------------------------------------------------------
  // UNILATERAL EXIT (CSV) — buyer and seller together, never either alone.
  // A single-key exit leaf would hand that party the escrow outright after the
  // delay, which is the thing this contract exists to prevent.
  // -------------------------------------------------------------------------
  function unilateral(signature buyerSig, signature sellerSig) tapscript {
    require(older(exit));
    require(checkMultisig([buyerPk, sellerPk], [buyerSig, sellerSig], 2));
  }
}
