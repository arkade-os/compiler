// Bridge Mint Contract (deposit leg)
//
// Arkade rendering of the Near Intents PoA bridge deposit flow
// (omft.near factory + *.omft.near tokens): a custodian quorum observes a
// deposit on a foreign chain and mints the wrapped asset to the depositor
// on Arkade.
//
// Flow:
//   1. User requests a deposit address for the foreign chain from the
//      bridge operator (off-chain, per-user address — as in Near Intents).
//   2. User sends the native asset (ETH, SOL, USDT, ...) to that address.
//   3. After confirmation, k-of-n custodians sign
//        msg = sha256(depositId || recipientSpk || amount || nonce)
//      where depositId is a domain-separated hash of the source-chain
//      deposit (e.g. sha256("arkade-bridge-deposit-v1" || chain || txid || vout)),
//      recipientSpk is the 34-byte Arkade script pubkey the wrapped tokens
//      must land on, and nonce is this contract's current mint sequence.
//   4. Anyone (typically the operator) spends this UTXO with the quorum
//      signatures: the covenant mints `amount` wrapped tokens to
//      recipientSpk and re-creates itself with nonce + 1.
//
// Replay protection: the attested message binds this contract's `nonce`,
// and every mint advances it in the continuation output — a given
// attestation can be used at most once. Custodians attest deposits in
// sequence order.
//
// Because the attestation commits to an arbitrary script pubkey (not just
// a key), a deposit can be minted straight into another contract — e.g. a
// NonInteractiveSwap offer — mirroring Near Intents' DepositMessage
// `execute_intents` chaining.
//
// Supply integrity: minting requires the control asset (held by this
// contract) to be present and preserved, so wrapped supply can only grow
// through quorum-attested deposits.

contract BridgeMint(
  // Wrapped asset (e.g. wrapped USDT on Arkade)
  bytes32 tokenAssetIdTxid,
  int tokenAssetIdGidx,
  // Control asset gating mint authority for the wrapped asset
  bytes32 ctrlAssetIdTxid,
  int ctrlAssetIdGidx,
  // Bridge custodian set and quorum threshold (k-of-n)
  pubkey[] custodians,
  int threshold,
  // Mint sequence number; advances by 1 on every mint
  int nonce,
  // Exit timelock in blocks (propagated for playground parity)
  int exit
) {
  // Mint: quorum-attested deposit credit.
  //
  // Transaction layout:
  //   input[0]:  this BridgeMint UTXO (carries the control asset)
  //   output[0]: next BridgeMint state (control asset, nonce + 1)
  //   output[1]: `amount` wrapped tokens to recipientSpk
  function mint(
    int amount,
    bytes recipientSpk,
    bytes32 depositId,
    signature[] custodianSigs
  ) {
    require(amount > 0, "zero mint");
    require(threshold > 0, "zero threshold");
    require(size(recipientSpk) == 34, "bad recipient spk");

    // Reconstruct the custodian-signed deposit attestation on stack.
    let attestedMsg = sha256(depositId + recipientSpk + amount + nonce);
    int valid = 0;
    for (i, sig) in custodianSigs {
      if (checkSigFromStack(sig, custodians[i], attestedMsg)) {
        valid = valid + 1;
      }
    }
    require(valid >= threshold, "quorum failed");

    // Supply grows by exactly the attested amount, under the control asset.
    let tokenGroup = tx.assetGroups.find(tokenAssetIdTxid, tokenAssetIdGidx);
    require(tokenGroup.delta == amount, "delta mismatch");
    require(tokenGroup.controlIs(ctrlAssetIdTxid, ctrlAssetIdGidx), "wrong control");

    let ctrlGroup = tx.assetGroups.find(ctrlAssetIdTxid, ctrlAssetIdGidx);
    require(ctrlGroup.delta == 0, "ctrl supply changed");

    // Recipient receives the minted tokens at the attested script.
    require(
      tx.outputs[1].assets.lookup(tokenAssetIdTxid, tokenAssetIdGidx) >= amount,
      "mint short"
    );
    require(tx.outputs[1].scriptPubKey == recipientSpk, "wrong recipient");

    // State continuation: same bridge, nonce advanced, control retained.
    int nextNonce = nonce + 1;
    require(
      tx.outputs[0].scriptPubKey == new BridgeMint(
        tokenAssetIdTxid, tokenAssetIdGidx,
        ctrlAssetIdTxid, ctrlAssetIdGidx,
        custodians, threshold, nextNonce, exit
      ),
      "state broken"
    );
    require(
      tx.outputs[0].assets.lookup(ctrlAssetIdTxid, ctrlAssetIdGidx) > 0,
      "ctrl not continued"
    );
  }
}
