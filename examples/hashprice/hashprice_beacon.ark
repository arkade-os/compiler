pragma arkade ^0.1.0;

// HashpriceBeacon publishes one integer, the current hashprice, as an asset
// amount. `heightAsset` is a monotonic counter so an oracle signature cannot
// be replayed. Both amounts move only in `update`. `passthrough` forwards the
// coin unchanged, which is how another contract reads it in the same spend.
//
// The oracle signs sha256(outpoint || num2bin(hashprice, 8) || num2bin(height, 8)).
// Hashprice and strike in the consumer share one integer scale. This contract
// does not fix that scale.

contract HashpriceBeacon(
  pubkey oraclePk,
  AssetId hashpriceAsset,
  AssetId heightAsset
) {
  @allow(unsigned-spend-path, "the oracle signature authorizes the new hashprice and height, and the output keeps this beacon")
  function update(int newHashprice, int newHeight, signature oracleSig) {
    require(this.activeInputIndex == 0, "beacon is input 0");
    require(newHashprice > 0, "hashprice");

    int height = tx.inputs[0].assets.lookup(heightAsset.txid, heightAsset.gidx);
    require(newHeight > height, "height");

    let outpoint = tx.input.current.outpoint;
    let message = sha256(outpoint.txid + num2bin(outpoint.vout, 4) + num2bin(newHashprice, 8) + num2bin(newHeight, 8));
    require(checkSigFromStack(oracleSig, oraclePk, message), "oracle");

    // Script and value stay. The two published amounts are the exception, and
    // the checks below bind them to the signed values.
    require(this.tunnel(0, {
      script: true, value: true, assets: true
    }, [hashpriceAsset, heightAsset]));
    require(tx.outputs[0].assets.lookup(hashpriceAsset.txid, hashpriceAsset.gidx) == newHashprice, "hashprice output");
    require(tx.outputs[0].assets.lookup(heightAsset.txid, heightAsset.gidx) == newHeight, "height output");
  }

  @allow(unsigned-spend-path, "anyone may forward the beacon unchanged so another contract can read it")
  function passthrough() {
    require(this.activeInputIndex == 0, "beacon is input 0");
    require(this.tunnel(0));
  }
}
