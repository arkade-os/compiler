pragma arkade ^0.1.0;

// Threshold Oracle Contract
// Generic threshold signature verifier for multi-oracle attestations.
//
// This contract demonstrates:
// - Array types in constructor params (pubkey[3] oracles)
// - Array types in function params (signature[3] oracleSigs)
// - Array indexing (oracles[i])
// - Loop unrolling with array iteration
// - Threshold counting for quorum verification
//
// N oracles, require M valid signatures over a message.

contract ThresholdOracle(
  bytes32 tokenAssetIdTxid,
  int tokenAssetIdGidx,
  bytes32 ctrlAssetIdTxid,
  int ctrlAssetIdGidx,
  pubkey[3] oracles,
  int threshold
) {
  @allow(unsigned-spend-path, "an oracle quorum signs this input, amount and recipient")
  function attest(
    int amount,
    ScriptPubKey recipientScriptPubKey,
    signature[3] oracleSigs
  ) {
    require(amount > 0, "zero");

    // The oracles sign this spend: its input, amount and recipient.
    let outpoint = tx.input.current.outpoint;
    let message = sha256(outpoint.txid + num2bin(outpoint.vout, 4) + num2bin(amount, 8) + recipientScriptPubKey.program + num2bin(recipientScriptPubKey.version, 1));
    int valid = 0;
    for (i, sig) in oracleSigs {
      if (checkSigFromStack(sig, oracles[i], message)) {
        valid = valid + 1;
      }
    }
    require(valid >= threshold, "quorum failed");

    require(tx.inputs[0].assets.lookup(ctrlAssetIdTxid, ctrlAssetIdGidx) > 0, "no ctrl");
    require(tx.outputs[1].assets.lookup(tokenAssetIdTxid, tokenAssetIdGidx) >= amount, "short");
    require(tx.outputs[1].script == recipientScriptPubKey, "wrong dest");
    require(tx.outputs[0].script == new ThresholdOracle(tokenAssetIdTxid, tokenAssetIdGidx, ctrlAssetIdTxid, ctrlAssetIdGidx, oracles, threshold), "broken");
    require(tx.outputs[0].value >= tx.input.current.value, "value lost");
  }
}
